{
  "buildCommand": "npm run build",
  "installCommand": "npm install && cd server && npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-discover",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/run-daily-outbound",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/blog-daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/morning-brief",
      "schedule": "30 6 * * 1-5"
    },
    {
      "path": "/api/cron/auto-nudge",
      "schedule": "0 10 * * 1-5"
    }
  ]
}
