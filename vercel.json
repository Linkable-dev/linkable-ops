{
  "buildCommand": "npm run build",
  "installCommand": "npm install && cd server && npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/run-daily-outbound?cap=30",
      "schedule": "0 8-15 * * 1-5"
    },
    {
      "path": "/api/cron/run-due?limit=50",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/follow-ups?limit=50",
      "schedule": "0 9 * * *"
    }
  ]
}
